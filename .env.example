# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public Site Canonical URL (Used for SEO Sitemap, OpenGraph & Auth Redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Authentication (Server-Only)
ADMIN_EMAIL=admin@example.com

# Server-Only secrets for the protected API routes (generate each with: openssl rand -hex 32)
# CRON_SECRET: Vercel Cron sends it automatically to /api/keep-alive (daily Supabase heartbeat)
# REVALIDATE_SECRET: required as `Authorization: Bearer <secret>` for POST /api/revalidate
CRON_SECRET=
REVALIDATE_SECRET=

# Optional: AI Chatbot LLM Keys (Server-Only)
# Option A: Google Gemini API Key (https://aistudio.google.com/apikey)
# Option B: Groq Cloud API Key - 100% Free without credit card (https://console.groq.com/keys)
GEMINI_API_KEY=
GROQ_API_KEY=
